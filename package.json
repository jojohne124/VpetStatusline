{
  "name": "agumon-cli",
  "version": "2.0.0",
  "description": "Animated pixel-art character (Agumon, etc.) for Claude CLI / Cursor CLI statusline.",
  "main": "src/runtime/statusline-agumon-color.js",
  "bin": {
    "vpet": "bin/vpet.js"
  },
  "scripts": {
    "install-runtime": "node scripts/install.js",
  "build-release": "node scripts/build-release.js",
  "publish-release": "node scripts/publish-release.js",
    "uninstall-runtime": "node scripts/uninstall.js",
    "uninstall-runtime:purge": "node scripts/uninstall.js --purge",
    "char": "node src/tools/char-cli.js",
    "editor": "node src/editor/sprite_editor_server.js",
    "gen-shared": "node scripts/gen-shared-placeholders.js",
    "gen-bullets": "node scripts/gen-bullet-placeholders.js",
    "gen-shadow": "node scripts/gen-shadow.js",
    "test": "node scripts/test-time-of-day.js && node scripts/test-shadow-fallback.js"
  },
  "keywords": ["statusline", "claude-cli", "cursor-cli", "pixel-art", "agumon"],
  "author": "kaihsiangchang",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "os": ["win32", "darwin", "linux"],
  "dependencies": {
    "log-update": "^8.0.0",
    "sharp": "^0.34.5"
  }
}
